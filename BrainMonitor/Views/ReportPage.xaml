<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="BrainMirror.Views.ReportPage"
    Background="{DynamicResource SystemControlPageBackgroundAltHighBrush}" 
    av:DesignWidth="800">

    <ScrollViewer x:Name="MainScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="ReportContent" Margin="40,20,40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 主标题和机构信息 -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- 左侧：机构信息 -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="机构" 
                        FontSize="13"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <TextBlock Text="深圳神溯未来科技有限公司" 
                        FontSize="15"
                        FontWeight="Bold"
                        Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- 右侧：报告标题和编号 -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="AD 风险检测报告"
                        FontSize="22"
                        FontWeight="Bold"
                        HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                        <TextBlock Text="报告编号：" 
                            FontSize="13"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        <TextBlock x:Name="ReportIdText" 
                            FontSize="13"
                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="HeaderReportTimeText"
                        FontSize="13"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        HorizontalAlignment="Right"
                        Margin="0,2,0,0"/>
                </StackPanel>
                
                <!-- 现代化分割线 -->
                <Border Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="2" Margin="0,0,0,-10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/>
                            <GradientStop Color="#FFB3D1F0" Offset="0.1"/>
                            <GradientStop Color="#FFA3C7E8" Offset="0.5"/>
                            <GradientStop Color="#FFB3D1F0" Offset="0.9"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- 1. 基本信息 -->
            <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,5"
                BorderBrush="#FFD0D0D0"
                BorderThickness="2"
                CornerRadius="36">
                <StackPanel>
                    <TextBlock Text="1.基本信息" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="姓名：" FontSize="15" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TesterNameText" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="性别/年龄：" FontSize="15" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TesterGenderText" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="/" FontSize="15" FontWeight="Bold" Margin="2,0,2,0"/>
                                <TextBlock x:Name="TesterAgeText" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="手机号：" FontSize="15" Margin="0,0,5,0"/>
                                <TextBlock x:Name="TesterPhoneText" FontSize="15" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 2. AD风险和3. 握力与认知能力 -->
            <Grid Grid.Row="2" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 2. AD风险 (圆环图) -->
                <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}" 
                    Margin="0,0,5,0"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="2"
                    CornerRadius="36">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="2.AD风险" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                        <!-- 圆环图 -->
                        <Grid Grid.Row="1" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Canvas x:Name="RiskRingCanvas" Width="120" Height="120"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="RiskPercentageText" 
                                    FontSize="32" 
                                    FontWeight="Bold" 
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                                <TextBlock x:Name="RiskLevelText" 
                                    FontSize="14" 
                                    HorizontalAlignment="Center"
                                    Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. 握力与认知能力 (进度条) -->
                <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}" 
                    Margin="5,0,0,0"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="2"
                    CornerRadius="36">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="3.握力与认知能力" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        
                        <!-- MoCA进度条 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MocaLabelText" Text="MoCA" FontSize="14" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="18" Background="#FFE5E5E5" CornerRadius="9" Margin="10,0,10,0">
                                <Border x:Name="MocaProgressBar" 
                                    HorizontalAlignment="Left" 
                                    CornerRadius="9"
                                    Background="#FF4A9EFF"/>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="MocaValueText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- MMSE进度条 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="MmseLabelText" Text="MMSE" FontSize="14" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="18" Background="#FFE5E5E5" CornerRadius="9" Margin="10,0,10,0">
                                <Border x:Name="MmseProgressBar" 
                                    HorizontalAlignment="Left" 
                                    CornerRadius="9"
                                    Background="#FF4A9EFF"/>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="MmseValueText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 握力进度条 -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="GripLabelText" Text="握力" FontSize="14" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="18" Background="#FFE5E5E5" CornerRadius="9" Margin="10,0,10,0">
                                <Border x:Name="GripProgressBar" 
                                    HorizontalAlignment="Left" 
                                    CornerRadius="9"
                                    Background="#FF4A9EFF"/>
                            </Border>
                            <TextBlock Grid.Column="2" x:Name="GripValueText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. 脑电分析结果 -->
            <Border Grid.Row="3" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,5"
                BorderBrush="#FFD0D0D0"
                BorderThickness="2"
                CornerRadius="36">
                <StackPanel>
                    <TextBlock Text="4.脑电分析结果" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <!-- 脑电波柱状图 -->
                    <Border Height="160"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        CornerRadius="6"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1">
                        <Grid>
                            <Canvas x:Name="BrainwaveChartCanvas" Margin="10,0,10,0" />
                            <TextBlock Text="核心关联脑电波分析" 
                                FontSize="14" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Top"
                                Margin="0,5,0,0"
                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 5. 综合解读 -->
            <Border Grid.Row="4" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,5"
                BorderBrush="#FFD0D0D0"
                BorderThickness="2"
                CornerRadius="36">
                <StackPanel>
                    <TextBlock Text="5.综合解读" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <!-- 总体风险水平 -->
                    <TextBlock Text="总体风险水平" FontSize="15" FontWeight="Bold" Margin="15,0,0,4"/>
                    <TextBlock x:Name="OverallRiskText" TextWrapping="Wrap" FontSize="13" Margin="15,0,0,8" LineHeight="20"/>
                    
                    <!-- 重点关注 -->
                    <TextBlock Text="重点关注" FontSize="15" FontWeight="Bold" Margin="15,0,0,4"/>
                    <TextBlock x:Name="KeyFocusText" TextWrapping="Wrap" FontSize="13" Margin="15,0,0,8" LineHeight="20"/>
                    
                    <!-- 简单运动建议 -->
                    <TextBlock Text="简单运动建议" FontSize="15" FontWeight="Bold" Margin="15,0,0,4"/>
                    <TextBlock x:Name="ExerciseAdviceText" TextWrapping="Wrap" FontSize="13" Margin="15,0,0,8" LineHeight="20"/>
                    
                    <!-- 随访建议 -->
                    <TextBlock Text="随访建议" FontSize="15" FontWeight="Bold" Margin="15,0,0,4"/>
                    <TextBlock x:Name="FollowUpAdviceText" TextWrapping="Wrap" FontSize="13" Margin="15,0,0,0" LineHeight="20"/>
                </StackPanel>
            </Border>

            <!-- 6. 免责声明与注意事项 -->
            <Border Grid.Row="5" 
                Style="{StaticResource CardStyle}" 
                Margin="0,0,0,5"
                BorderBrush="#FFD0D0D0"
                BorderThickness="2"
                CornerRadius="36">
                <StackPanel>
                    <TextBlock Text="6.免责声明与注意事项" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock x:Name="DisclaimerText" TextWrapping="Wrap" FontSize="13" LineHeight="19" 
                        Margin="15,0,0,0"
                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                </StackPanel>
            </Border>

            <!-- 个性化提示 -->
            <StackPanel Grid.Row="6" Margin="0,8,0,8">
                <TextBlock Text="个人医疗定制化解读及后续服务请联系专业服务人员"
                    FontSize="13"
                    Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 返回和导出按钮 -->
            <Grid Grid.Row="7" Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" 
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Center"
                    Width="120"
                    Click="ReturnButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE72B;" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="返回"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" 
                    Style="{StaticResource ModernButton}"
                    HorizontalAlignment="Center"
                    Width="120"
                    Click="ExportPdfButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE8A5;" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="导出PDF"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>